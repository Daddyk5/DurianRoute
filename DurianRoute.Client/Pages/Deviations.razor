@page "/deviations"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject TelemetryClient Telemetry
@inject LiveStore Live
@inject ISnackbar Snackbar

<PageTitle>Schedule &amp; headways · DurianRoute</PageTitle>

<header class="page-head">
    <div>
        <h1 class="page-title">Schedule &amp; headways</h1>
        <p class="page-sub">How far each bus is from its timetable, and the gap to the bus ahead on the same route</p>
    </div>
</header>

<section class="kpis" aria-label="Schedule summary">
    <div class="kpi"><span class="kpi-label">Buses tracked</span><span class="kpi-value">@Live.Buses.Count</span><span class="kpi-note">@Live.Buses.Count(b => b.Status == BusStatus.Layover) on layover</span></div>
    <div class="kpi @(Late > 0 ? "kpi-alert" : "")"><span class="kpi-label">Running late</span><span class="kpi-value">@Late</span><span class="kpi-note">more than 5 min behind</span></div>
    <div class="kpi"><span class="kpi-label">Running early</span><span class="kpi-value">@Early</span><span class="kpi-note">more than 4 min ahead</span></div>
    <div class="kpi @(Bunching > 0 ? "kpi-warn" : "")"><span class="kpi-label">Bunching</span><span class="kpi-value">@Bunching</span><span class="kpi-note">headway under 3 min</span></div>
    <div class="kpi kpi-wide"><span class="kpi-label">Average deviation</span><span class="kpi-value">@AvgDeviation<small> min</small></span><span class="kpi-note">positive = behind schedule</span></div>
    <div class="kpi kpi-wide"><span class="kpi-label">Average headway</span><span class="kpi-value">@AvgHeadway<small> min</small></span><span class="kpi-note">between consecutive buses</span></div>
</section>

<MudGrid Spacing="2">
    <MudItem xs="12" lg="7">
        <MudTable T="BusPositionDto" Items="@Live.Buses.OrderByDescending(b => LiveStore.IsLate(b) || LiveStore.IsBunching(b)).ThenByDescending(b => Math.Abs(b.DeviationMinutes))"
                  Dense="true" Hover="true" Elevation="0" Class="card">
            <ToolBarContent><MudText Typo="Typo.h6">Live fleet</MudText></ToolBarContent>
            <HeaderContent>
                <MudTh>Bus</MudTh>
                <MudTh>Route</MudTh>
                <MudTh>Direction</MudTh>
                <MudTh>Next stop</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Headway</MudTh>
                <MudTh>Deviation</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="white-space:nowrap"><b>@context.PlateNumber</b></MudTd>
                <MudTd>@context.RouteCode</MudTd>
                <MudTd>@context.Direction</MudTd>
                <MudTd>@context.NextStop</MudTd>
                <MudTd Style="white-space:nowrap">@Format.Status(context.Status)</MudTd>
                <MudTd>
                    @if (context.HeadwayMinutes is { } h)
                    {
                        <span class="@(LiveStore.IsBunching(context) ? "text-warn" : "")">@h.ToString("0.0") min@(LiveStore.IsBunching(context) ? " · bunching" : "")</span>
                    }
                    else
                    {
                        <span class="muted">lead</span>
                    }
                </MudTd>
                <MudTd Style="white-space:nowrap"><MudChip T="string" Size="Size.Small" Color="@Format.DeviationColor(context.DeviationMinutes)">@Format.Deviation(context.DeviationMinutes)</MudChip></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>Waiting for telemetry…</MudText></NoRecordsContent>
        </MudTable>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudTable T="DeviationAlertDto" Items="_alerts" Dense="true" Hover="true" Elevation="0" Height="620px" FixedHeader="true" Class="card">
            <ToolBarContent><MudText Typo="Typo.h6">Alert log</MudText></ToolBarContent>
            <HeaderContent>
                <MudTh>Time</MudTh>
                <MudTh>Route</MudTh>
                <MudTh>Alert</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@Format.Time(context.TimestampUtc)</MudTd>
                <MudTd>@context.RouteCode</MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Color="@(context.DeviationMinutes > 0 ? Color.Error : Color.Info)">@context.Message</MudText>
                    <MudText Typo="Typo.caption">near @context.NearStop</MudText>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>No deviation alerts yet.</MudText></NoRecordsContent>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    private List<DeviationAlertDto> _alerts = [];

    private int Late => Live.Buses.Count(LiveStore.IsLate);
    private int Early => Live.Buses.Count(LiveStore.IsEarly);
    private int Bunching => Live.Buses.Count(LiveStore.IsBunching);
    private string AvgDeviation => Live.Buses.Count == 0 ? "–" : Live.Buses.Average(b => b.DeviationMinutes).ToString("+0.0;-0.0;0.0");
    private string AvgHeadway
    {
        get
        {
            var h = Live.Buses.Where(b => b.HeadwayMinutes is not null).Select(b => b.HeadwayMinutes!.Value).ToList();
            return h.Count == 0 ? "–" : h.Average().ToString("0.0");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Live.Changed += OnLiveChanged;
        Telemetry.DeviationAlert += OnAlert;
        try
        {
            _alerts = await Api.GetDeviationsAsync(200);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnLiveChanged() => InvokeAsync(StateHasChanged);

    private void OnAlert(DeviationAlertDto alert) => InvokeAsync(() =>
    {
        _alerts.Insert(0, alert);
        if (_alerts.Count > 200) _alerts.RemoveAt(_alerts.Count - 1);
        StateHasChanged();
    });

    public void Dispose()
    {
        Live.Changed -= OnLiveChanged;
        Telemetry.DeviationAlert -= OnAlert;
    }
}
