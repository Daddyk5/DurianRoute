@page "/lanes"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject TelemetryClient Telemetry
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Lane management · DurianRoute</PageTitle>

<header class="page-head">
    <div>
        <h1 class="page-title">Lane management</h1>
        <p class="page-sub">
            @if (_isAdmin)
            {
                <span>You approve or reject every lane change. System recommendations and dispatcher requests wait here for your decision.</span>
            }
            else
            {
                <span>Lane changes need the admin's approval. Request a change and you'll be notified of the decision.</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReplanAsync" Disabled="_busy">Re-plan now</MudButton>
        @if (!_isAdmin)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="@(() => OpenRequestAsync(null))" Disabled="_busy">Request lane change</MudButton>
        }
    </div>
</header>

@* ---------- Waiting for a decision ---------- *@
<section class="card section">
    <div class="section-head">
        <h2>@(_isAdmin ? "Waiting for your decision" : "Waiting for the admin")</h2>
        <span class="count-pill @(Pending.Any() ? "warn" : "")">@Pending.Count()</span>
    </div>
    @if (!Pending.Any())
    {
        <p class="empty">@(_loading ? "Loading…" : "Nothing is waiting. The balanced layout is best for the forecast right now.")</p>
    }
    else
    {
        <div class="decision-list">
            @foreach (var rec in Pending)
            {
                var item = rec;
                var isRequest = item.Source == RecommendationSource.DispatcherRequest;
                <article class="decision @(isRequest ? "request" : "")">
                    <div class="decision-main">
                        <div class="decision-title">
                            <b>@item.ChokePointName</b>
                            <span class="arrow">→</span>
                            <span>@Format.Lane(item.State)</span>
                        </div>
                        <div class="decision-meta">
                            @if (isRequest)
                            {
                                <span class="tag tag-request"><MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Small" /> Requested by @item.RequestedBy</span>
                                <span>@((item.SlotEndUtc - item.SlotStartUtc).TotalHours.ToString("0")) h from approval</span>
                                <span>sent @Format.Time(item.CreatedAtUtc)</span>
                            }
                            else
                            {
                                <span class="tag tag-system"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /> System recommendation</span>
                                <span>@Format.Window(item.SlotStartUtc, item.SlotEndUtc)</span>
                                <span>saves ≈@item.EstimatedSavingsPersonMinutes.ToString("N0") person-min</span>
                            }
                        </div>
                        <p class="decision-reason">@item.Reason</p>
                    </div>
                    <div class="decision-actions">
                        @if (_isAdmin)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check"
                                       OnClick="@(() => DecideAsync(item, true))" Disabled="_busy">Approve</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close"
                                       OnClick="@(() => DecideAsync(item, false))" Disabled="_busy">Reject</MudButton>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.HourglassTop">Awaiting admin</MudChip>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@* ---------- Decided ---------- *@
<section class="card section">
    <div class="section-head"><h2>Scheduled, active and recent decisions</h2></div>
    <MudTable T="LaneRecommendationDto" Items="Decided" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
            <MudTh>Choke point</MudTh>
            <MudTh>Layout</MudTh>
            <MudTh>Window (PH time)</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Decided by</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ChokePointName</MudTd>
            <MudTd>@Format.Lane(context.State)</MudTd>
            <MudTd Style="white-space:nowrap">@Format.Window(context.SlotStartUtc, context.SlotEndUtc)</MudTd>
            <MudTd>@(context.Source == RecommendationSource.DispatcherRequest ? $"Request · {context.RequestedBy}" : "System")</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@Format.StatusColor(context.Status)">@context.Status</MudChip></MudTd>
            <MudTd>@(context.DecidedBy ?? "–")</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="muted">No decisions in the last 24 hours.</MudText></NoRecordsContent>
    </MudTable>
</section>

<MudGrid Spacing="2">
    @* ---------- Current configuration ---------- *@
    <MudItem xs="12" xl="7">
        <section class="card section h-100">
            <div class="section-head"><h2>Current configuration</h2></div>
            <MudTable T="ChokePointDto" Items="_chokePoints" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Choke point</MudTh>
                    <MudTh>Lanes/dir</MudTh>
                    <MudTh>Active layout</MudTh>
                    <MudTh>@(_isAdmin ? "Change now" : "")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name@(context.HasReversibleLane ? "" : " · no reversible lane")</MudTd>
                    <MudTd>@context.LanesPerDirection</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.ActiveLaneState == LaneState.Normal ? Color.Default : Color.Success)">@Format.Lane(context.ActiveLaneState)</MudChip></MudTd>
                    <MudTd>
                        @if (_isAdmin)
                        {
                            <MudSelect T="LaneState" Dense="true" Value="context.ActiveLaneState" ValueChanged="@(s => OverrideAsync(context, s))"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" Style="min-width:240px">
                                @foreach (var state in AllowedStates(context))
                                {
                                    <MudSelectItem Value="state">@Format.Lane(state)</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="@(() => OpenRequestAsync(context.Id))" Disabled="_busy">Request change</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </section>
    </MudItem>

    @* ---------- Audit ---------- *@
    <MudItem xs="12" xl="5">
        <section class="card section h-100">
            <div class="section-head"><h2>Audit log</h2></div>
            <MudTable T="LaneChangeAuditDto" Items="_audit" Dense="true" Elevation="0" Height="440px" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Time</MudTh>
                    <MudTh>Choke point</MudTh>
                    <MudTh>Change</MudTh>
                    <MudTh>By</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="white-space:nowrap">@Format.DateTimeText(context.TimestampUtc)</MudTd>
                    <MudTd>@context.ChokePointName</MudTd>
                    <MudTd>
                        @context.FromState → @context.ToState
                        <MudText Typo="Typo.caption" Class="muted">@context.Note</MudText>
                    </MudTd>
                    <MudTd>@context.Actor</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="muted">No lane changes yet.</MudText></NoRecordsContent>
            </MudTable>
        </section>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<LaneRecommendationDto> _recs = [];
    private List<ChokePointDto> _chokePoints = [];
    private List<LaneChangeAuditDto> _audit = [];
    private bool _loading = true;
    private bool _busy;
    private bool _isAdmin;

    // Dispatcher requests first: a person is waiting on them.
    private IEnumerable<LaneRecommendationDto> Pending => _recs
        .Where(r => r.Status == RecommendationStatus.Pending && r.SlotEndUtc > DateTime.UtcNow)
        .OrderByDescending(r => r.Source == RecommendationSource.DispatcherRequest)
        .ThenBy(r => r.SlotStartUtc);

    private IEnumerable<LaneRecommendationDto> Decided => _recs
        .Where(r => r.Status != RecommendationStatus.Pending)
        .OrderByDescending(r => r.Status is RecommendationStatus.Active or RecommendationStatus.Approved)
        .ThenByDescending(r => r.SlotStartUtc);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) _isAdmin = (await AuthState).User.IsInRole(Roles.Admin);
        Telemetry.RecommendationsUpdated += OnChanged;
        Telemetry.LaneConfigChanged += OnLaneChanged;
        await ReloadAsync();
    }

    private static IEnumerable<LaneState> AllowedStates(ChokePointDto cp) =>
        Enum.GetValues<LaneState>().Where(s => s switch
        {
            LaneState.ReversibleInbound or LaneState.ReversibleOutbound => cp.HasReversibleLane && cp.LanesPerDirection >= 2,
            LaneState.BusLaneInbound or LaneState.BusLaneOutbound => cp.LanesPerDirection >= 2,
            _ => true
        });

    private async Task ReloadAsync()
    {
        try
        {
            var recs = Api.GetRecommendationsAsync();
            var cps = Api.GetChokePointsAsync();
            var audit = Api.GetAuditAsync();
            _recs = await recs;
            _chokePoints = await cps;
            _audit = await audit;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DecideAsync(LaneRecommendationDto rec, bool approve)
    {
        var dialog = await Dialogs.ShowAsync<DecisionDialog>(null,
            new DialogParameters<DecisionDialog> { { d => d.Item, rec }, { d => d.Approve, approve } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var note = result.Data as string;
        await RunAsync(async () =>
        {
            if (approve) await Api.ApproveAsync(rec.Id, note);
            else await Api.RejectAsync(rec.Id, note);
            Snackbar.Add($"{(approve ? "Approved" : "Rejected")}: {rec.ChokePointName} → {Format.Lane(rec.State)}", approve ? Severity.Success : Severity.Info);
        });
    }

    private async Task OpenRequestAsync(int? chokePointId)
    {
        var dialog = await Dialogs.ShowAsync<LaneRequestDialog>(null,
            new DialogParameters<LaneRequestDialog> { { d => d.ChokePoints, _chokePoints }, { d => d.ChokePointId, chokePointId } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not LaneChangeRequestDto request) return;

        await RunAsync(async () =>
        {
            var sent = await Api.RequestLaneChangeAsync(request);
            Snackbar.Add($"Request sent to the admin: {sent.ChokePointName} → {Format.Lane(sent.State)}", Severity.Success);
        });
    }

    private Task OverrideAsync(ChokePointDto cp, LaneState state) =>
        RunAsync(() => Api.OverrideLaneAsync(cp.Id, state, "Changed directly by admin"));

    private Task ReplanAsync() => RunAsync(async () =>
    {
        var count = await Api.ReplanAsync();
        Snackbar.Add($"Plan refreshed: {count} recommendation(s)", Severity.Info);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnChanged() => InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); });

    private void OnLaneChanged(LaneConfigChangedDto _) => OnChanged();

    public void Dispose()
    {
        Telemetry.RecommendationsUpdated -= OnChanged;
        Telemetry.LaneConfigChanged -= OnLaneChanged;
    }
}
